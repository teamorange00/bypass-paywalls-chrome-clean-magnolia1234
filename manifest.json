{
  "manifest_version": 3,
  "name": "Bypass Paywalls Clean",
  "short_name": "Bypass Paywall",
  "version": "3.0.7.12",
  "description": "Bypass Paywalls of news sites",
  "homepage_url": "https://github.com/teamorange00/bypass-paywalls-chrome-clean-magnolia1234",
  "icons": {
    "128": "bypass.png"
  },
  "action": {
    "default_popup": "options/popup.html",
    "default_icon": "bypass.png"
  },
  "background": {
    "service_worker": "background-sw.js"
  },
  "options_ui": {
    "open_in_tab": true,
    "page": "options/options.html"
  },
  "permissions": [
    "storage",
    "scripting",
    "cookies",
    "webNavigation",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.theverge.com/*",
    "*://*.zephr.com/*",
    "*://assets.zephr.com/*",
    "*://*.ft.com/*",
    "*://ft.com/*",
    "*://*.ampproject.org/*",
    "*://consent-manager.ft.com/*",
    "*://*.wsj.com/*",
    "*://wsj.com/*",
    "*://*.wsj.net/*",
    "*://*.cxense.com/*",
    "*://*.tinypass.com/*",
    "*://*.piano.io/*",
    "*://*.economist.com/*",
    "*://economist.com/*",
    "*://*.telegraph.co.uk/*",
    "*://telegraph.co.uk/*",
    "*://assets.adobedtm.com/*",
    "*://*.thetimes.co.uk/*",
    "*://thetimes.co.uk/*",
    "*://*.thetimes.com/*",
    "*://thetimes.com/*",
    "*://*.bloomberg.com/*",
    "*://bloomberg.com/*",
    "*://*.bwbx.io/*",
    "*://*.nytimes.com/*",
    "*://nytimes.com/*",
    "*://*.nyt.com/*",
    "*://*.washingtonpost.com/*",
    "*://washingtonpost.com/*",
    "*://*.theatlantic.com/*",
    "*://theatlantic.com/*",
    "*://*.newyorker.com/*",
    "*://newyorker.com/*",
    "*://archive.ph/*",
    "*://*.archive.ph/*",
    "*://archive.today/*",
    "*://*.archive.today/*",
    "*://web.archive.org/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://*.theverge.com/*"],
      "js": ["contentScript_verge_early.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.theverge.com/*"],
      "js": ["lib/empty.js", "contentScript.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.ft.com/*",
        "*://ft.com/*"
      ],
      "js": ["contentScript_ft_early.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.ft.com/*",
        "*://ft.com/*"
      ],
      "js": ["lib/empty.js", "contentScript.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.wsj.com/*", "*://wsj.com/*"],
      "js": ["contentScript_wsj_early.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://*.wsj.com/*", "*://wsj.com/*"],
      "js": ["contentScript_wsj.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.economist.com/*", "*://economist.com/*"],
      "js": ["contentScript_economist.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.telegraph.co.uk/*", "*://telegraph.co.uk/*"],
      "js": ["contentScript_telegraph_early.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://*.telegraph.co.uk/*", "*://telegraph.co.uk/*"],
      "js": ["contentScript_telegraph.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.thetimes.co.uk/*",
        "*://thetimes.co.uk/*",
        "*://*.thetimes.com/*",
        "*://thetimes.com/*"
      ],
      "js": ["contentScript_times_early.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.thetimes.co.uk/*",
        "*://thetimes.co.uk/*",
        "*://*.thetimes.com/*",
        "*://thetimes.com/*"
      ],
      "js": ["contentScript_times.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.bloomberg.com/*", "*://bloomberg.com/*"],
      "js": ["contentScript_bloomberg_early.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://*.bloomberg.com/*", "*://bloomberg.com/*"],
      "js": ["contentScript_bloomberg.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.nytimes.com/*", "*://nytimes.com/*"],
      "js": ["contentScript_nytimes_early.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://*.nytimes.com/*", "*://nytimes.com/*"],
      "js": ["contentScript_nytimes.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.washingtonpost.com/*", "*://washingtonpost.com/*"],
      "js": ["contentScript_wapo_early.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://*.washingtonpost.com/*", "*://washingtonpost.com/*"],
      "js": ["contentScript_wapo.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.theatlantic.com/*", "*://theatlantic.com/*"],
      "js": ["contentScript_atlantic_early.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["*://*.theatlantic.com/*", "*://theatlantic.com/*"],
      "js": ["contentScript_atlantic.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.newyorker.com/*", "*://newyorker.com/*"],
      "js": ["contentScript_newyorker_early.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://*.newyorker.com/*", "*://newyorker.com/*"],
      "js": ["contentScript_newyorker.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "incognito": "split"
}
